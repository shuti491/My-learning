# @/Users/shruti.singh/git/offglide-conversational/agent-orchestrator/va_agentic/utils/cache_client.py:181-222
def set(self, key: str, value: Any, ttl: int = None, is_glide_backed: bool = None):
    """
    1. HTTP POST to Central Cache Service
    2. CCS writes to Valkey (L1)
    3. If is_glide_backed=true, CCS also writes to Glide (L2)
    4. Returns success
    """
    payload = {
        "key": key,
        "value": value,
        "instanceId": self.instance_id,
        "isGlideBacked": is_glide_backed
    }
    if ttl:
        payload["ttl"] = ttl
    
    response = self.session.post(
        f"{self.base_url}/set",
        headers=self._get_headers(),
        json=payload,
        timeout=self.timeout
    )
