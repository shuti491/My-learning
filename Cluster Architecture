async def _sse_event_generator(self, message: CSTurnMessage, request: Request):
    sse_queue = asyncio.Queue()
    set_request_sse_queue(sse_queue)
    
    # Launch pipeline execution in background
    pipeline_task = asyncio.create_task(
        execute_unified_orchestration(message, request)
    )
    
    # Stream events from queue
    while True:
        event = await sse_queue.get()
        if event["event"] == "done":
            break
        yield f"event: {event['event']}\ndata: {json.dumps(event['data'])}\n\n"
SSE Event Types:

message - Text chunks from LLM
tool_call - Tool invocation
tool_result - Tool completion
filler - Voice filler phrases (voice mode)
done - Turn complete
