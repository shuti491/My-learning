# @/Users/shruti.singh/git/offglide-conversational/agent-orchestrator/va_agentic/utils/cache_client.py:49-85
def _build_ssl_context():
    env = os.getenv("ENV", "dev").lower()
    if env == "dev":
        return False  # No SSL locally
    
    # Enforce mTLS for lab/prod/fedramp
    cert_path = os.getenv("CERT_PATH", "/etc/tls/tls.crt")
    key_path = os.getenv("KEY_PATH", "/etc/tls/tls.key")
    ca_cert_path = os.getenv("CA_CERT_PATH", "/etc/tls-ca/ca.crt")
    
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.load_verify_locations(cafile=ca_cert_path)
    ctx.load_cert_chain(certfile=cert_path, keyfile=key_path)
    return ctx
