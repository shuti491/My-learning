Request Flow Example: Cache GET
python
# @/Users/shruti.singh/git/offglide-conversational/agent-orchestrator/va_agentic/utils/cache_client.py:251-286
def get(self, key: str, is_glide_backed: Optional[bool] = None):
    """
    1. Check local TTLCache (L0)
    2. HTTP GET to Central Cache Service
    3. CCS checks Valkey (L1)
    4. On miss, CCS queries Glide API (L2)
    5. CCS populates Valkey and returns
    6. Client caches in TTLCache
    """
    params = {
        "instanceId": self.instance_id,
        "isGlideBacked": is_glide_backed
    }
    
    response = self.session.get(
        f"{self.base_url}/get/{key}",
        headers=self._get_headers(),  # Includes Glide-JWT, instance-keys, user-id
        params=params,
        timeout=self.timeout
    )
    
    return response.json().get("value") if response.status_code == 200 else None
