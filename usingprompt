def build_dare_system_prompt(
    *,
    identity_name: str = OTTO_IDENTITY_NAME,
    is_interactive: bool = True,
    enable_memory: bool = True,
    enable_user_persona: bool = False,
    enable_sub_agents: bool = True,
    enable_skills: bool = True,
    enable_context_compaction: bool = True,
    enable_parallel_sub_agents: bool = True,
    enable_builtin_web_search: bool = True,
    enable_builtin_knowledge_base: bool = True,
    enable_planning: bool = True,
    enable_filesystem: bool = True,
) -> str:
    """Compose the DARE system prompt from isolated section constants.

    Args:
        identity_name: Name the agent introduces itself as.
        is_interactive: Use the interactive identity and user communication
            variant; include collect_input_from_user capability and rules.
            When False (background mode) all three are omitted.
        enable_memory: Include Memory & Context section. When False the
            section is omitted.
        enable_sub_agents: Include spawn_agent capability and delegation
            guidance. When False both are omitted.
        enable_skills: Include skill tool mention in capabilities.
            When False the reference to skill is omitted.
        enable_context_compaction: Include the compaction survival line in the
            System section. When False the line is omitted so the agent does
            not assume cross-turn continuity via compaction.
        enable_parallel_sub_agents: When False, appends a note to the
            sub-agent delegation section informing the agent to spawn one at
            a time.
        enable_builtin_web_search: When False, omits "web search" from the
            built-in services list in capabilities so the prompt matches the
            actual tool set.
        enable_builtin_knowledge_base: When False, omits "knowledge base"
            from the built-in services list in capabilities.
        enable_planning: When False, omits the planning capability bullet
            and the task management section so the prompt does not reference
            update_plan when the tool is absent.

    Returns:
        Fully assembled system prompt string ending with a single newline.
    """
    # Pick one isolated variant per conditional surface — no inline mutations.
    identity = SECTION_IDENTITY_INTERACTIVE if is_interactive else SECTION_IDENTITY_AUTONOMOUS
    system = _compose_system_section(
        is_interactive=is_interactive,
        enable_context_compaction=enable_context_compaction,
    )
    if is_interactive:
        methodology = SECTION_WORKING_METHODOLOGY
        task_mgmt = SECTION_TASK_MANAGEMENT
        failure = SECTION_FAILURE_HANDLING
        search = SECTION_SEARCH_QUERY_STRATEGY
        op_policy = SECTION_OPERATIONAL_POLICY_INTERACTIVE
        reporting = SECTION_REPORTING_OUTCOMES
        formatting = SECTION_RESPONSE_FORMATTING
    else:
        methodology = SECTION_WORKING_METHODOLOGY_AUTONOMOUS
        task_mgmt = SECTION_TASK_MANAGEMENT_AUTONOMOUS
        failure = SECTION_FAILURE_HANDLING_AUTONOMOUS
        search = SECTION_SEARCH_QUERY_STRATEGY_AUTONOMOUS
        op_policy = SECTION_OPERATIONAL_POLICY_AUTONOMOUS
        reporting = SECTION_REPORTING_OUTCOMES_AUTONOMOUS
        formatting = SECTION_RESPONSE_FORMATTING_AUTONOMOUS

    sections = [
        identity.format(identity_name=identity_name),
        *([system] if system else []),
        methodology,
        _compose_capabilities(
            is_interactive=is_interactive,
            enable_sub_agents=enable_sub_agents,
            enable_skills=enable_skills,
            enable_builtin_web_search=enable_builtin_web_search,
            enable_builtin_knowledge_base=enable_builtin_knowledge_base,
            enable_planning=enable_planning,
            enable_filesystem=enable_filesystem,
        ),
        SECTION_OUT_OF_REACH_TASKS,
        *([SECTION_VOICE_AND_TONE_INTERACTIVE] if is_interactive else []),
        SECTION_EXECUTING_ACTIONS_CARE,
        SECTION_TOOL_USE_GENERAL,
        *([task_mgmt] if enable_planning else []),
        *(
            [
                _compose_subagent_section(
                    enable_parallel_sub_agents=enable_parallel_sub_agents,
                )
            ]
            if enable_sub_agents
            else []
        ),
        *([SECTION_COLLECT_INPUT_RULES] if is_interactive else []),
        *([SECTION_USER_COMMUNICATION_INTERACTIVE] if is_interactive else []),
        *(
            [SECTION_MEMORY_CONTEXT + ("\n\n" + _user_persona_primer() if enable_user_persona else "")]
            if enable_memory
            else []
        ),
        *([SECTION_WORKSPACE_PERSISTENCE] if enable_filesystem else []),
        failure,
        search,
        op_policy,
        reporting,
        formatting,
        SECTION_ACTIVITY_LABELS,
    ]
    return "\n\n".join(s.strip("\n") for s in sections if s.strip()) + "\n"


