def _compose_capabilities(
    *,
    is_interactive: bool,
    enable_sub_agents: bool,
    enable_skills: bool = True,
    enable_builtin_web_search: bool = True,
    enable_builtin_knowledge_base: bool = True,
    enable_planning: bool = True,
    enable_filesystem: bool = True,
) -> str:
    """Pick the correct isolated planning variant, assemble capabilities block."""
    planning = CAPABILITY_PLANNING_INTERACTIVE if is_interactive else CAPABILITY_PLANNING_AUTONOMOUS

    # Compute the two template slots and render the platform-tools bullet.
    # Prompt wording lives in _CAPABILITY_PLATFORM_TOOLS_TEMPLATE above.
    services = []
    if enable_builtin_knowledge_base:
        services.append("knowledge base")
    if enable_builtin_web_search:
        services.append("web search")
    builtin_services = ", ".join(services) if services else "none"
    skills_suffix = " Skill files may surface deeper guidance for specific tool families." if enable_skills else ""
    platform_tools = _CAPABILITY_PLATFORM_TOOLS_TEMPLATE.format(
        builtin_services=builtin_services,
        skills_suffix=skills_suffix,
    )

    items = [
        SECTION_CAPABILITIES_HEADER,
        platform_tools,
        *([planning] if enable_planning else []),
    ]

    if enable_sub_agents:
        type_list = "explore/plan/verification/general_purpose"
        items.append(f"- **Sub-Agents**\n   - `spawn_agent`: delegate an isolated slice of work ({type_list}).")

    if enable_filesystem:
        items.append(CAPABILITY_VFS)
    return "\n\n".join(items)


def _compose_system_section(
    *,
    is_interactive: bool,
    enable_context_compaction: bool,
) -> str:
    """Compose the System section for interactive mode; omitted for background."""
    if not is_interactive:
        return ""
    base = _SYSTEM_BASE_INTERACTIVE
    if not enable_context_compaction:
        return base
    compaction = _SYSTEM_COMPACTION_LINE_WITH_VFS
    return base + "\n" + compaction


def _compose_subagent_section(
    *,
    enable_parallel_sub_agents: bool,
) -> str:
    """Compose the sub-agent delegation section.

    Always emits the full section naming all four types. The
    ``core_sub_agents`` feature toggle controls whether spawn_agent exists
    at all; when it does, all types are available.
    """
    base = SECTION_SUBAGENT_DELEGATION

    if not enable_parallel_sub_agents:
        base += (
            "\n\n**Note**: Parallel sub-agent spawning is disabled — "
            "spawn one sub-agent at a time and wait for it to complete before spawning the next."
        )
    return base


